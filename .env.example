# ==============================================================================
# IdeaProof AI - Environment Configuration Example
# Copy this file to .env.local and configure your API credentials.
# Do NOT commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary AI Provider: OpenRouter (OpenAI-compatible)
# ------------------------------------------------------------------------------
# Obtain an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Target model identifier on OpenRouter.
# Recommended options:
# - nvidia/nemotron-3-super-120b-a12b (Default: High-reasoning academic planning)
# - nvidia/nemotron-3.5-super-vl:free (Free-tier NVIDIA Nemotron)
# - nvidia/nemotron-3-ultra-550b-a55b (Frontier MoE for complex hypothesis generation)
# - meta-llama/llama-3.3-70b-instruct (Fast academic instruction-following)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Custom endpoint override (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Swappable / Alternative AI Provider: Nebius Token Factory
# ------------------------------------------------------------------------------
# To swap providers without changing code, configure the variables below instead:
# NEBIUS_API_KEY=your_nebius_api_key_here
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ------------------------------------------------------------------------------
# Optional Generic Provider Fallbacks
# ------------------------------------------------------------------------------
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=your_api_key_here
# AI_MODEL=nvidia/nemotron-3-super-120b-a12b
