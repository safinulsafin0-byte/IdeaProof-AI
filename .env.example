# Nebius Token Factory API Key (Required for live NVIDIA Nemotron inference)
# Obtain from your Nebius AI Studio account at https://studio.nebius.ai
NEBIUS_API_KEY=your_nebius_api_key_here

# Supported NVIDIA Nemotron model identifiers on Nebius Token Factory:
# - nvidia/nemotron-3-super-120b-a12b (Default: High-reasoning Mixture-of-Experts)
# - nvidia/Nemotron-3-Ultra-550b-a55b (Frontier MoE for autonomous research workflows)
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Aligned instruction-tuned Nemotron)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Next.js Node Environment
NODE_ENV=development

